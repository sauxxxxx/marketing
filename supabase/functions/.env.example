# Server-side secrets for Supabase Edge Functions. Placeholders only.
# Apply with: supabase secrets set --env-file supabase/functions/.env

# One-time setup token the installer must enter on the /setup page.
# Generate with: openssl rand -base64 32   (remove after setup if you like)
BOOTSTRAP_TOKEN=replace-with-a-long-random-string

# Public URL of the deployed app; used for invitation redirect links.
APP_URL=https://studio.example.com

# Comma-separated list of browser origins allowed to call the functions.
ALLOWED_ORIGINS=https://studio.example.com,http://localhost:5173
