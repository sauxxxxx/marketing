# Frontend (exposed to the browser by Vite — PUBLIC values only).
# Copy to .env.local for development. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public base URL of this app (used to build redirect links).
VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Edge Function secrets — DO NOT put these in .env.local for Vite.
# Set them with:  supabase secrets set --env-file supabase/functions/.env
# (see supabase/functions/.env.example). SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# ---------------------------------------------------------------------------
